# Helius Odometer configuration. Copy to .env and fill in.
# Guardrails (docs/PLAN.md): buying a Helius plan, funding wallets, deploying,
# and any public listing all need the owner's explicit approval first.

# --- Server ---------------------------------------------------------------
PORT=8787
# Browser-visible origin, no path. SIWx proofs are bound to it.
PUBLIC_ORIGIN=https://odometer.example.com
DATABASE_PATH=./data/odometer.db
LOG_LEVEL=info
# Set to true only behind a reverse proxy that overwrites X-Forwarded-For.
TRUST_PROXY=false
# Public name on the paywall page, index, llms.txt, SIWx sign-in statement and
# Bazaar metadata. Keep it neutral until the Helius name is approved for this use.
# SERVICE_NAME=Pay-per-call Solana RPC

# --- Payments (x402) --------------------------------------------------------
X402_NETWORK=solana:5eykt4UsFv8P8NJdTREpY1vzqKqZKvdp
# Any x402 v2 facilitator with Solana mainnet support (compare CDP and PayAI
# terms first), or a self-hosted one: npm run facilitator.
X402_FACILITATOR_URL=https://facilitator.example.com
# Optional Authorization header value sent to the facilitator.
# X402_FACILITATOR_AUTH_HEADER=Bearer ...
# Operator wallet that receives top-ups. Its USDC token account must exist.
PAYTO_ADDRESS=
# Defaults to USDC for the network.
# PAYMENT_ASSET=EPjFWdd5AufqSSqeM2qN1xzybapC8G4wEGGkZwyTDt1v
TOPUP_OPTIONS_USD=1,5,20

# --- Sessions ---------------------------------------------------------------
# 32+ random characters, e.g. `openssl rand -hex 32`. Sessions die on restart if unset.
SESSION_SECRET=
SESSION_TTL_SECONDS=1800

# --- Helius (fast tier, Helius-only methods, escalation) --------------------
# Written permission from Helius is required before commercial use (docs/PLAN.md).
HELIUS_API_KEY=
# Or a full URL instead of the key:
# HELIUS_RPC_URL=https://mainnet.helius-rpc.com/?api-key=...
# Match your plan's limits (Developer: 50 req/s, sendTransaction reported at 5/s).
HELIUS_RPS=50
HELIUS_SEND_TX_RPS=5
HELIUS_HEAVY_RPS=10
# HELIUS_SENDER_URL=https://sender.helius-rpc.com/fast
# HELIUS_API_BASE=https://api-mainnet.helius-rpc.com

# --- Free public pool (economy and standard tiers) --------------------------
# Review each provider's terms before serving their capacity to paying users
# (docs/UPSTREAM_TERMS_CHECKLIST.md). Keep rps within published free limits.
# PUBLIC_UPSTREAMS=[{"id":"solana-public","url":"https://api.mainnet-beta.solana.com","rps":4}]

# --- Policy -----------------------------------------------------------------
# sendTransaction stays off until Helius confirms Sender/staked paths may be fronted.
ENABLE_SEND_TRANSACTION=false
# Operator ceiling per wallet per UTC day (USD), or "none". Wallets can only lower it.
WALLET_DAILY_CAP_USD=10
WALLET_RPS=25
IP_RPS=20
MAX_BATCH=25
# PRICING_FILE=./pricing.json

# Bazaar discovery metadata lets facilitators list this service publicly.
# That is a public listing: keep false until the owner approves (docs/PLAN.md).
BAZAAR_DISCOVERY=false

# Commitment injected when a request sets none: processed, confirmed, finalized
# or none. All tiers default to confirmed, so a request means the same data on
# every tier.
# ECONOMY_COMMITMENT=confirmed
# STANDARD_COMMITMENT=confirmed
# FAST_COMMITMENT=confirmed

# --- Remote MCP (/mcp) -------------------------------------------------------
REMOTE_MCP_ENABLED=true
# A session may spend only what it paid, until this many seconds after paying
# (0 = SESSION_TTL_SECONDS), and only from the IP that paid when BIND_IP is on.
# Revoking the wallet ends its sessions at once.
REMOTE_MCP_SESSION_TTL_SECONDS=0
REMOTE_MCP_BIND_IP=true
REMOTE_MCP_SESSIONS_PER_MINUTE=10
REMOTE_MCP_MAX_SESSIONS=5000

# --- Alerts -----------------------------------------------------------------
# Every alert is logged. A webhook (Slack-compatible, or a pager bridge) makes
# sure unknown settlement outcomes and ledger mismatches reach a person.
# ALERT_WEBHOOK_URL=https://hooks.example.com/...
# ALERT_WEBHOOK_AUTH_HEADER=Bearer ...
# Repeats of one alert are suppressed for this many minutes.
ALERT_DEDUPE_MINUTES=15

# --- Retention ----------------------------------------------------------------
# How long Idempotency-Key replays, and GET /v1/receipts lookups by request id, last.
IDEMPOTENCY_RETENTION_HOURS=24
RESERVATION_RETENTION_DAYS=30

# --- Operator API -----------------------------------------------------------
# Enables /admin/* when set (16+ characters).
# ADMIN_TOKEN=
